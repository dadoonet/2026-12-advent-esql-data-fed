    {
      "type": "vis",
      "grid": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 12
      },
      "config": {
        "type": "xy",
        "title": "[Elasticsearch] 2026 planned deliveries",
        "layers": [
          {
            "type": "bar_stacked",
            "data_source": {
              "type": "esql",
              "query": "FROM santa_delivery_plan_2026_v2\n| STATS planned_deliveries = SUM(planned_deliveries) BY gift_category\n| SORT planned_deliveries DESC, gift_category ASC\n| LIMIT 10\n"
            },
            "x": {
              "column": "gift_category"
