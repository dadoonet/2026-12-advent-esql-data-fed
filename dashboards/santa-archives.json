            "type": "bar_stacked",
            "data_source": {
              "type": "esql",
              "query": "FROM santa_deliveries_2025\n| STATS total = COUNT(*), late = COUNT(*) WHERE delay_minutes > 0 BY gift_category\n| EVAL late_rate = 100.0 * late / total\n| SORT late_rate DESC, gift_category ASC\n| LIMIT 10\n"
