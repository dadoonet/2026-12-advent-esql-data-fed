# demo.sh creates .env with random local credentials if it does not exist.
# To customize: copy this file to .env and replace every CHANGE_ME value.
ES_VERSION=9.6.0-SNAPSHOT
KIBANA_VERSION=9.6.0-SNAPSHOT
ES_PORT=9200
KIBANA_PORT=5601
S3_PORT=9000
S3_CONSOLE_PORT=9001
ES_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
S3_URL=http://localhost:9000
# Seen from Elasticsearch containers, not from the host:
S3_ES_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
ES_USERNAME=elastic
ES_PASSWORD=CHANGE_ME
KIBANA_PASSWORD=CHANGE_ME
KIBANA_ENCRYPTION_KEY=CHANGE_ME_USE_AT_LEAST_32_CHARACTERS
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
READY_TIMEOUT=240
